# VisaMOTionAi iOS App Configuration

# Mistral AI Configuration
# Get your API key from https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1

# App Configuration
APP_NAME=VisaMOTionAi
APP_VERSION=1.0.0
APP_DESCRIPTION=Mistral AI powered chat assistant for iOS

# WebView Configuration
# The URL that will be loaded in the WebView
# Use the hosted NextChat instance or your own deployment
WEBVIEW_URL=https://app.nextchat.club
# For local development, use:
# WEBVIEW_LOCAL_URL=http://localhost:3000

# Feature Flags
ENABLE_CAMERA=true
ENABLE_FILE_PICKER=true
ENABLE_SHARE=true
ENABLE_NOTIFICATIONS=true
ENABLE_BIOMETRIC_AUTH=false
ENABLE_GOOGLE_SIGN_IN=false

# OneSignal Configuration (for push notifications)
# Get your app ID from https://onesignal.com
ONESIGNAL_APP_ID=your_onesignal_app_id_here

# Deep Link Configuration
DEEP_LINK_SCHEME=visamotionai

# Google Sign In Configuration (optional)
GOOGLE_IOS_CLIENT_ID=your_google_client_id_here
GOOGLE_ANDROID_CLIENT_ID=your_google_client_id_here

# App Store Configuration
APP_STORE_ID=your_app_store_id_here

# Post Install Scripts
post_install do |installer|
  installer.pods_project.targets.each do |target|
    if target.name == "VisaMOTionAi"
      target.build_configurations.each do |config|
        # Enable Objective-C exceptions
        config.build_settings['GCC_ENABLE_OBJC_EXCEPTIONS'] = 'YES'
        
        # Enable ARC
        config.build_settings['CLANG_ENABLE_OBJC_ARC'] = 'YES'
        
        # Enable Objective-C GC
        config.build_settings['GCC_ENABLE_OBJC_GC'] = 'supported'
        
        # Set iOS deployment target
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        
        # Enable bitcode
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        
        # Set architectures
        config.build_settings['ARCHS'] = '$(ARCHS_STANDARD)'
        
        # Set only active architectures
        config.build_settings['ONLY_ACTIVE_ARCHS'] = 'YES'
        
        # Set build active architecture only
        config.build_settings['BUILD_ACTIVE_ARCHITECTURE_ONLY'] = 'YES'
        
        # Set SDK root
        config.build_settings['SDKROOT'] = 'iphoneos'
        
        # Set code signing
        config.build_settings['CODE_SIGN_IDENTITY'] = 'iPhone Developer'
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
        config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
        config.build_settings['DEVELOPMENT_TEAM'] = ''
      end
    end
  end
end
